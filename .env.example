# ── Session ────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your-secret-here

# ── Environnement ───────────────────────────────────────────────────────────────
# "production" active secure cookie et désactive les logs de dev
NODE_ENV=development

# ── Serveur ─────────────────────────────────────────────────────────────────────
PORT=3000

# ── Déploiement ─────────────────────────────────────────────────────────────────
# Token pour le webhook /webhook/deploy (git pull + pm2 restart)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPLOY_TOKEN=your-deploy-token-here

# ── Emails ──────────────────────────────────────────────────────────────────────
# Destinataire du planning cuisine hebdomadaire
PLANNING_RECIPIENT=pverdier.mospub@gmail.com

# Destinataire des notifications congés approuvés
PAUL_EMAIL=pverdier.mospub@gmail.com
